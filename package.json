{
  "name": "foreman",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @foreman/server\" \"npm run dev -w @foreman/web\"",
    "build": "npm run build -w @foreman/web",
    "start": "npm run start -w @foreman/server",
    "demo": "npm run demo -w @foreman/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
